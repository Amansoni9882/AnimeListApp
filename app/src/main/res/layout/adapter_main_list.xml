<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/_50sdp"
        android:id="@+id/logoIV"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="@dimen/_70sdp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="0dp"
        android:id="@+id/nameTV"
        android:text="Name : One piece"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_10sdp"
        android:maxLines="2"
        app:layout_constraintTop_toTopOf="@id/logoIV"
        app:layout_constraintStart_toEndOf="@id/logoIV"
        android:layout_marginStart="@dimen/_5sdp"
        android:textStyle="bold"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:id="@+id/episodesTV"
        android:text="Episodes : 10"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/nameTV"
        app:layout_constraintStart_toEndOf="@id/logoIV"
        android:layout_marginStart="@dimen/_5sdp"
        android:textStyle="bold"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:id="@+id/ratingTV"
        android:text="Rating : 10"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/episodesTV"
        app:layout_constraintStart_toEndOf="@id/logoIV"
        android:layout_marginStart="@dimen/_5sdp"
        android:textStyle="bold"
        android:layout_height="wrap_content"/>


</androidx.constraintlayout.widget.ConstraintLayout>